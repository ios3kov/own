# Keep the local AI runtime reproducible from its checked package sources.
ENV['RNLLAMA_BUILD_FROM_SOURCE'] = '1'

require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, '17.0'  # Raised to 17.0 for ml-stable-diffusion (Core ML image gen)

prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'Own' do
  config = use_native_modules!
  
  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  target 'OwnTests' do
    inherit! :search_paths
  end

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )
    
    # fmt 11's consteval detection fails with this React Native/Xcode combination.
    fmt_base = File.join(installer.sandbox.root, 'fmt', 'include', 'fmt', 'base.h')
    if File.exist?(fmt_base)
      original = File.read(fmt_base)
      needle = '#if !defined(__cpp_lib_is_constant_evaluated)'
      unless original.include?('// Personal build: Apple clang consteval compatibility')
        raise 'Unexpected fmt header; review the compatibility patch' unless original.include?(needle)
        updated = original.sub(needle, "#if defined(__apple_build_version__)\n#  define FMT_USE_CONSTEVAL 0 // Personal build: Apple clang consteval compatibility\n#elif !defined(__cpp_lib_is_constant_evaluated)")
        File.chmod(0644, fmt_base)
        File.write(fmt_base, updated)
      end
    end

    # Set C++20 for all pods and deployment target
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'c++20'
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '17.0'
        paths = Array(config.build_settings['HEADER_SEARCH_PATHS'] || '$(inherited)')
        config.build_settings['HEADER_SEARCH_PATHS'] = (paths + ['"$(PODS_ROOT)/.."']).uniq
        # Suppress fmt consteval errors on newer Xcode/clang
        if target.name == 'fmt'
          config.build_settings['GCC_TREAT_WARNINGS_AS_ERRORS'] = 'NO'
          config.build_settings['OTHER_CPLUSPLUSFLAGS'] = '$(inherited) -Wno-error'
        end
      end
    end
  end
end
